# Server port
PORT=3001

# Monad Testnet RPC URL
MONAD_RPC_URL=https://testnet-rpc.monad.xyz

# Relayer account private key (sponsors gasless transactions)
RELAYER_PRIVATE_KEY=

# Community steward private key
STEWARD_PRIVATE_KEY=

# Demo buyer private key
BUYER_PRIVATE_KEY=

# Secret key used for signing delivery download links
DOWNLOAD_SECRET=

# Public URL of the server (e.g. http://localhost:3001)
PUBLIC_URL=http://localhost:3001
